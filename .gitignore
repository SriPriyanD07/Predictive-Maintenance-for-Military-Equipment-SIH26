# python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# ML artifacts: the pickle IS shared through git so teammates need not retrain
*.pkl
!ml/*.pkl

# raw C-MAPSS: too large for git, everyone downloads their own copy.
